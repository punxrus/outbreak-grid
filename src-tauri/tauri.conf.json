{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outbreak Grid",
  "version": "0.1.0",
  "identifier": "com.outbreakgrid.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Outbreak Grid", "width": 1600, "height": 960, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
